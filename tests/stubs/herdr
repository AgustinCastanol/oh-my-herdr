#!/bin/sh
# Test stub for herdr. Logs its arguments to $STUB_LOG and fakes the
# commands install.sh uses. It never starts or contacts a real herdr.
#
#   STUB_HERDR_VERSION     version to report (default 0.9.5)
#   STUB_HERDR_CHECK_FAIL  1 makes `config check` report an issue and exit 1;
#                          so does a checked file with a not_a_herdr_key line,
#                          standing in for herdr rejecting an unknown key
#   STUB_HERDR_SERVER      "running" pretends a herdr server is running
#   STUB_HERDR_LINK_FAIL   1 makes every `plugin link` fail
#   STUB_HERDR_UNLINK_FAIL plugin id whose `plugin unlink` fails
#   STUB_HERDR_PANE_GET    file printed by `pane get <id>` (default: an error)
#   STUB_HERDR_PANE_LIST   file printed by `pane list` (default: an error)
#   STUB_HERDR_PANE_LIST_FAIL 1 makes `pane list` exit 1 with nothing on stdout
#   STUB_HERDR_REPORT_FAIL 1 makes `pane report-metadata` fail
#   STUB_HERDR_REPORT_DELAY seconds a `pane report-metadata ... --token` call
#                          takes (with STUB_REAL_SLEEP as sleep, if set);
#                          while it runs $STUB_LOG.report-busy exists.
#                          Every report-metadata call appends its arguments to
#                          $STUB_LOG.reports-done when it finishes
#   STUB_HERDR_SPLIT_FAIL  1 makes `pane split` fail; it otherwise reports a
#                          new pane w1:p9
#   STUB_HERDR_SPLIT_UNREADABLE 1 makes `pane split` succeed with output that
#                          names no pane; after it, `pane list` prints
#                          STUB_HERDR_PANE_LIST_AFTER_SPLIT when that is set
#   STUB_HERDR_AGENTS      file printed by `agent list` (default: no agents)
#   STUB_HERDR_AGENT_LIST_FAIL 1 makes `agent list` fail
#   STUB_HERDR_AGENT_LIST_DELAY seconds `agent list` waits after it has read
#                          STUB_HERDR_AGENTS (it then creates $STUB_LOG.list-read)
#   STUB_HERDR_AGENT_LIST_TOUCH file `agent list` creates every time it runs
#   STUB_HERDR_WORKSPACES  file printed by `workspace list` (default: none)
#   STUB_HERDR_TABS        file printed by `tab list` (default: none)
#   STUB_HERDR_FOCUS_FAIL  1 makes `agent focus` fail like a missing agent
#   STUB_HERDR_PANE_READ   file printed by `pane read` (default: nothing)
#   STUB_HERDR_PANE_READ_FAIL file holding an error code, such as
#                          pane_not_found; while it exists, `pane read` fails
#                          with that code (server_not_running on stderr, as
#                          herdr does, others on stdout)
#   STUB_HERDR_NOTIFY_FAIL 1 makes `notification show` fail
#   STUB_HERDR_PROMPT_FAIL 1 makes `agent prompt` fail like a blocked agent;
#                          otherwise it saves its target, argument count, and
#                          text to $STUB_LOG.prompt-target, .prompt-argc, and
#                          .prompt-text (and .prompt-text.TARGET)
#   STUB_HERDR_START_DELAY seconds `agent start` takes before it answers
#   STUB_HERDR_START_FAIL  agent kind whose `agent start` fails outright
#   STUB_HERDR_START_NOT_READY agent kind whose `agent start` reports
#                          agent_not_ready (waiting at a startup prompt)
#   STUB_HERDR_WAIT_FAIL   1 makes `agent wait` time out
#   STUB_HERDR_OPEN_FAIL   text; `worktree open` fails when its label contains it.
#                          Otherwise it reports workspace ws-LABEL with root
#                          pane LABEL:p1
#   STUB_HERDR_PLUGINS          plugin ids `plugin list --json` reports as installed
#   STUB_HERDR_PLUGIN_LIST_FAIL 1 makes `plugin list --json` fail
#   STUB_HERDR_PLUGIN_LIST_PRETTY 1 makes `plugin list --json` pretty-print
#                               its JSON over several indented lines
#   STUB_HERDR_PANE_OPEN_FAIL   1 makes `plugin pane open` fail
#   STUB_HERDR_INSTALL_FAIL     plugin source whose `plugin install` fails
#   STUB_HERDR_UNINSTALL_FAIL   plugin id whose `plugin uninstall` fails
#   STUB_HERDR_INTEGRATIONS     output of `integration status` (default: none)
#   STUB_HERDR_INTEGRATION_FAIL 1 makes `integration status` exit 1 after
#                               printing STUB_HERDR_INTEGRATIONS anyway, plus
#                               a parseable-looking line on stderr; a caller
#                               must trust neither

log="${STUB_LOG:?STUB_LOG is not set}"
printf 'herdr %s\n' "$*" >>"$log"

server_running() {
  [ "${STUB_HERDR_SERVER:-}" = running ]
}

not_running() {
  echo '{"id":"cli","error":{"code":"server_not_running","message":"no herdr server is running at stub.sock"}}'
  exit 1
}

case "$*" in
  --version | -V)
    echo "herdr ${STUB_HERDR_VERSION:-0.9.5}"
    ;;
  "config check")
    printf 'herdr config check HERDR_CONFIG_PATH=%s\n' "${HERDR_CONFIG_PATH:-}" >>"$log"
    if [ "${STUB_HERDR_CHECK_FAIL:-0}" = 1 ] ||
      grep -q '^not_a_herdr_key' "${HERDR_CONFIG_PATH:-/dev/null}" 2>/dev/null; then
      echo "config: issues found"
      echo "stub: unknown config key ui.bogus; ignoring key"
      exit 1
    fi
    echo "config: ok"
    ;;
  "status server")
    if server_running; then echo "status: running"; else echo "status: not running"; fi
    echo "socket: stub.sock"
    ;;
  "server reload-config")
    server_running || not_running
    echo '{"id":"cli","result":{"diagnostics":[],"status":"applied","type":"config_reload"}}'
    ;;
  "pane get "*)
    [ -f "${STUB_HERDR_PANE_GET:-}" ] || not_running
    cat "$STUB_HERDR_PANE_GET"
    ;;
  "pane list")
    if [ "${STUB_HERDR_PANE_LIST_FAIL:-0}" = 1 ]; then
      echo "herdr stub: pane list failed" >&2
      exit 1
    fi
    if [ -f "$log.split-done" ] && [ -f "${STUB_HERDR_PANE_LIST_AFTER_SPLIT:-}" ]; then
      cat "$STUB_HERDR_PANE_LIST_AFTER_SPLIT"
      exit 0
    fi
    [ -f "${STUB_HERDR_PANE_LIST:-}" ] || not_running
    cat "$STUB_HERDR_PANE_LIST"
    ;;
  "pane split "*)
    if [ "${STUB_HERDR_SPLIT_FAIL:-0}" = 1 ]; then
      not_running
    fi
    : >"$log.split-done"
    if [ "${STUB_HERDR_SPLIT_UNREADABLE:-0}" = 1 ]; then
      echo 'split: ok'
      exit 0
    fi
    echo '{"id":"cli:pane:split","result":{"pane":{"pane_id":"w1:p9","focused":false},"type":"pane_info"}}'
    ;;
  "pane run "* | "pane close "*) ;;
  "plugin pane open "*)
    [ "${STUB_HERDR_PANE_OPEN_FAIL:-0}" != 1 ] || not_running
    ;;
  "pane report-metadata "*)
    if [ "${STUB_HERDR_REPORT_FAIL:-0}" = 1 ]; then
      not_running
    fi
    case " $* " in
      *" --token "*)
        if [ -n "${STUB_HERDR_REPORT_DELAY:-}" ]; then
          : >"$log.report-busy"
          "${STUB_REAL_SLEEP:-sleep}" "$STUB_HERDR_REPORT_DELAY"
          rm -f "$log.report-busy"
        fi
        ;;
    esac
    printf '%s\n' "$*" >>"$log.reports-done"
    ;;
  "integration status")
    [ -z "${STUB_HERDR_INTEGRATIONS:-}" ] || printf '%s\n' "$STUB_HERDR_INTEGRATIONS"
    if [ "${STUB_HERDR_INTEGRATION_FAIL:-0}" = 1 ]; then
      echo "codex: outdated (v1 < v2) (/stub/stderr-noise)" >&2
      exit 1
    fi
    ;;
  "agent list")
    [ "${STUB_HERDR_AGENT_LIST_FAIL:-0}" != 1 ] || not_running
    if [ -f "${STUB_HERDR_AGENTS:-}" ]; then
      agents=$(cat "$STUB_HERDR_AGENTS")
    else
      agents='{"id":"cli:agent:list","result":{"agents":[],"type":"agent_list"}}'
    fi
    [ -z "${STUB_HERDR_AGENT_LIST_TOUCH:-}" ] || : >"$STUB_HERDR_AGENT_LIST_TOUCH"
    if [ -n "${STUB_HERDR_AGENT_LIST_DELAY:-}" ]; then
      : >"$log.list-read"
      # Killable while it waits, so a caller's time limit leaves no sleep.
      sleep "$STUB_HERDR_AGENT_LIST_DELAY" &
      delay_pid=$!
      trap 'kill "$delay_pid" 2>/dev/null; exit 143' TERM INT
      wait "$delay_pid"
    fi
    printf '%s\n' "$agents"
    ;;
  "workspace list")
    if [ -f "${STUB_HERDR_WORKSPACES:-}" ]; then
      cat "$STUB_HERDR_WORKSPACES"
    else
      echo '{"id":"cli:workspace:list","result":{"type":"workspace_list","workspaces":[]}}'
    fi
    ;;
  "tab list")
    if [ -f "${STUB_HERDR_TABS:-}" ]; then
      cat "$STUB_HERDR_TABS"
    else
      echo '{"id":"cli:tab:list","result":{"tabs":[],"type":"tab_list"}}'
    fi
    ;;
  "agent focus "*)
    if [ "${STUB_HERDR_FOCUS_FAIL:-0}" = 1 ]; then
      printf '{"error":{"code":"agent_not_found","message":"agent target %s not found"},"id":"cli:agent:focus"}\n' "$3"
      exit 1
    fi
    printf '{"id":"cli:agent:focus","result":{"agent":{"pane_id":"%s","focused":true},"type":"agent_info"}}\n' "$3"
    ;;
  "pane read "*)
    if [ -f "${STUB_HERDR_PANE_READ_FAIL:-}" ]; then
      code=$(cat "$STUB_HERDR_PANE_READ_FAIL")
      if [ "$code" = server_not_running ]; then
        printf '{"id":"cli:pane:read","error":{"code":"%s","message":"no herdr server"}}\n' "$code" >&2
      else
        printf '{"error":{"code":"%s","message":"stub read failure"},"id":"cli:pane:read"}\n' "$code"
      fi
      exit 1
    fi
    [ ! -f "${STUB_HERDR_PANE_READ:-}" ] || cat "$STUB_HERDR_PANE_READ"
    ;;
  "notification show "*)
    [ "${STUB_HERDR_NOTIFY_FAIL:-0}" != 1 ] || not_running
    echo '{"id":"cli:notification:show","result":{"reason":"disabled","shown":false,"type":"notification_show"}}'
    ;;
  "agent start --help")
    printf 'Usage: herdr agent start <NAME> --kind <KIND> --pane <ID> [OPTIONS]\n'
    printf '          [possible values: pi, claude, codex, gemini, opencode, kiro]\n'
    ;;
  "agent start "*)
    kind=''
    previous=''
    for arg in "$@"; do
      [ "$previous" != --kind ] || kind=$arg
      previous=$arg
    done
    # herdr's rule for agent names: a lowercase letter, then lowercase
    # letters, digits, '-' or '_', 1 to 32 characters in all.
    if ! printf '%s\n' "$3" | grep -Eqx '[a-z][a-z0-9_-]{0,31}'; then
      printf '{"error":{"code":"invalid_agent_name","message":"agent name must start with a lowercase letter and contain only lowercase letters, digits, - or _ (1-32 characters)"},"id":"cli:agent:start"}\n'
      exit 1
    fi
    [ -z "${STUB_HERDR_START_DELAY:-}" ] || sleep "$STUB_HERDR_START_DELAY"
    if [ "$kind" = "${STUB_HERDR_START_FAIL:-}" ]; then
      printf '{"error":{"code":"pane_not_ready","message":"pane is not at a shell prompt"},"id":"cli:agent:start"}\n'
      exit 1
    fi
    if [ "$kind" = "${STUB_HERDR_START_NOT_READY:-}" ]; then
      printf '{"error":{"code":"agent_not_ready","message":"agent is blocked at startup"},"id":"cli:agent:start"}\n'
      exit 1
    fi
    printf '{"id":"cli:agent:start","result":{"agent":{"name":"%s","agent_status":"idle","interactive_ready":true},"type":"agent_started"}}\n' "$3"
    ;;
  "agent wait "*)
    if [ "${STUB_HERDR_WAIT_FAIL:-0}" = 1 ]; then
      printf '{"error":{"code":"timeout","message":"timed out waiting for agent"},"id":"cli:agent:wait"}\n'
      exit 1
    fi
    printf '{"id":"cli:agent:wait","result":{"agent":{"name":"%s","agent_status":"idle"},"type":"agent_info"}}\n' "$3"
    ;;
  "agent get "*)
    printf '{"id":"cli:agent:get","result":{"agent":{"name":"%s","agent":"claude","agent_status":"working"},"type":"agent_info"}}\n' "$3"
    ;;
  "worktree open "*)
    label=''
    previous=''
    for arg in "$@"; do
      [ "$previous" != --label ] || label=$arg
      previous=$arg
    done
    case "$label" in
      *"${STUB_HERDR_OPEN_FAIL:-no failure}"*)
        printf '{"error":{"code":"worktree_open_failed","message":"stub could not open %s"},"id":"cli:worktree:open"}\n' "$label"
        exit 1
        ;;
    esac
    printf '{"id":"cli:worktree:open","result":{"type":"worktree_opened","workspace":{"workspace_id":"ws-%s","label":"%s"},"root_pane":{"pane_id":"%s:p1"}}}\n' "$label" "$label" "$label"
    ;;
  "workspace create "*)
    printf '{"id":"cli:workspace:create","result":{"type":"workspace_created","workspace":{"workspace_id":"w9"}}}\n'
    ;;
  "workspace focus "*)
    printf '{"id":"cli:workspace:focus","result":{"type":"ok"}}\n'
    ;;
  "workspace get "*)
    printf '{"id":"cli:workspace:get","result":{"workspace":{"workspace_id":"%s","label":"%s"},"type":"workspace_info"}}\n' "$3" "${3#ws-}"
    ;;
  "workspace close "*)
    printf '{"id":"cli:workspace:close","result":{"type":"workspace_closed"}}\n'
    ;;
  "agent prompt "*)
    if [ "${STUB_HERDR_PROMPT_FAIL:-0}" = 1 ]; then
      echo '{"error":{"code":"agent_blocked","message":"agent is blocked"},"id":"cli:agent:prompt"}'
      exit 1
    fi
    printf '%s\n' "$3" >"$log.prompt-target"
    printf '%s\n' "$#" >"$log.prompt-argc"
    printf '%s' "$4" >"$log.prompt-text"
    printf '%s' "$4" >"$log.prompt-text.$3"
    echo '{"id":"cli:agent:prompt","result":{"agent":{"agent_status":"working"}}}'
    ;;
  "plugin list --json")
    if [ "${STUB_HERDR_PLUGIN_LIST_FAIL:-0}" = 1 ]; then
      not_running
    fi
    if [ "${STUB_HERDR_PLUGIN_LIST_PRETTY:-0}" = 1 ]; then
      printf '{\n  "id": "cli:plugin",\n  "result": {\n    "plugins": ['
      separator=''
      for plugin in ${STUB_HERDR_PLUGINS:-}; do
        printf '%s\n      {\n        "enabled": true,\n        "plugin_id": "%s",\n        "source": {\n          "kind": "github"\n        }\n      }' "$separator" "$plugin"
        separator=','
      done
      printf '\n    ],\n    "type": "plugin_list"\n  }\n}\n'
      exit 0
    fi
    plugins=''
    for plugin in ${STUB_HERDR_PLUGINS:-}; do
      plugins="${plugins:+$plugins,}{\"enabled\":true,\"plugin_id\":\"$plugin\",\"source\":{\"kind\":\"github\"}}"
    done
    printf '{"id":"cli:plugin","result":{"plugins":[%s],"type":"plugin_list"}}\n' "$plugins"
    ;;
  "plugin install "*)
    if [ "$3" = "${STUB_HERDR_INSTALL_FAIL:-}" ]; then
      echo "herdr stub: could not install $3" >&2
      exit 1
    fi
    ;;
  "plugin uninstall "*)
    if [ "$3" = "${STUB_HERDR_UNINSTALL_FAIL:-}" ]; then
      echo "plugin not installed: $3"
      exit 1
    fi
    ;;
  "plugin link "*)
    if [ "${STUB_HERDR_LINK_FAIL:-0}" = 1 ]; then
      echo '{"id":"cli:plugin","error":{"code":"invalid_manifest","message":"stub link failure"}}'
      exit 1
    fi
    echo '{"id":"cli:plugin","result":{"type":"plugin_linked"}}'
    ;;
  "plugin unlink "*)
    server_running || not_running
    if [ "$3" = "${STUB_HERDR_UNLINK_FAIL:-}" ]; then
      echo '{"id":"cli:plugin","error":{"code":"internal","message":"stub unlink failure"}}'
      exit 1
    fi
    echo '{"id":"cli:plugin","result":{"removed":true,"type":"plugin_unlinked"}}'
    ;;
  *)
    echo "herdr stub: unsupported arguments: $*" >&2
    exit 2
    ;;
esac
