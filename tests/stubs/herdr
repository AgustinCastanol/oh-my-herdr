#!/bin/sh
# Test stub for herdr. Logs its arguments to $STUB_LOG and fakes the
# commands install.sh uses. It never starts or contacts a real herdr.
#
#   STUB_HERDR_VERSION     version to report (default 0.9.5)
#   STUB_HERDR_CHECK_FAIL  1 makes `config check` report an issue and exit 1;
#                          so does a checked file with a not_a_herdr_key line,
#                          standing in for herdr rejecting an unknown key
#   STUB_HERDR_SERVER      "running" pretends a herdr server is running
#   STUB_HERDR_LINK_FAIL   1 makes every `plugin link` fail
#   STUB_HERDR_UNLINK_FAIL plugin id whose `plugin unlink` fails
#   STUB_HERDR_PANE_GET    file printed by `pane get <id>` (default: an error)
#   STUB_HERDR_PANE_LIST   file printed by `pane list` (default: an error)
#   STUB_HERDR_PANE_LIST_FAIL 1 makes `pane list` exit 1 with nothing on stdout
#   STUB_HERDR_REPORT_FAIL 1 makes `pane report-metadata` fail
#   STUB_HERDR_SPLIT_FAIL  1 makes `pane split` fail; it otherwise reports a
#                          new pane w1:p9
#   STUB_HERDR_SPLIT_UNREADABLE 1 makes `pane split` succeed with output that
#                          names no pane; after it, `pane list` prints
#                          STUB_HERDR_PANE_LIST_AFTER_SPLIT when that is set
#   STUB_HERDR_AGENTS      file printed by `agent list` (default: no agents)
#   STUB_HERDR_PANE_READ   file printed by `pane read` (default: nothing)
#   STUB_HERDR_PROMPT_FAIL 1 makes `agent prompt` fail like a blocked agent;
#                          otherwise it saves its target, argument count, and
#                          text to $STUB_LOG.prompt-target, .prompt-argc, and
#                          .prompt-text
#   STUB_HERDR_PLUGINS          plugin ids `plugin list --json` reports as installed
#   STUB_HERDR_PLUGIN_LIST_FAIL 1 makes `plugin list --json` fail
#   STUB_HERDR_PANE_OPEN_FAIL   1 makes `plugin pane open` fail
#   STUB_HERDR_INSTALL_FAIL     plugin source whose `plugin install` fails
#   STUB_HERDR_UNINSTALL_FAIL   plugin id whose `plugin uninstall` fails
#   STUB_HERDR_INTEGRATIONS     output of `integration status` (default: none)
#   STUB_HERDR_INTEGRATION_FAIL 1 makes `integration status` exit 1 after
#                               printing STUB_HERDR_INTEGRATIONS anyway, plus
#                               a parseable-looking line on stderr; a caller
#                               must trust neither

log="${STUB_LOG:?STUB_LOG is not set}"
printf 'herdr %s\n' "$*" >>"$log"

server_running() {
  [ "${STUB_HERDR_SERVER:-}" = running ]
}

not_running() {
  echo '{"id":"cli","error":{"code":"server_not_running","message":"no herdr server is running at stub.sock"}}'
  exit 1
}

case "$*" in
  --version | -V)
    echo "herdr ${STUB_HERDR_VERSION:-0.9.5}"
    ;;
  "config check")
    printf 'herdr config check HERDR_CONFIG_PATH=%s\n' "${HERDR_CONFIG_PATH:-}" >>"$log"
    if [ "${STUB_HERDR_CHECK_FAIL:-0}" = 1 ] ||
      grep -q '^not_a_herdr_key' "${HERDR_CONFIG_PATH:-/dev/null}" 2>/dev/null; then
      echo "config: issues found"
      echo "stub: unknown config key ui.bogus; ignoring key"
      exit 1
    fi
    echo "config: ok"
    ;;
  "status server")
    if server_running; then echo "status: running"; else echo "status: not running"; fi
    echo "socket: stub.sock"
    ;;
  "server reload-config")
    server_running || not_running
    echo '{"id":"cli","result":{"diagnostics":[],"status":"applied","type":"config_reload"}}'
    ;;
  "pane get "*)
    [ -f "${STUB_HERDR_PANE_GET:-}" ] || not_running
    cat "$STUB_HERDR_PANE_GET"
    ;;
  "pane list")
    if [ "${STUB_HERDR_PANE_LIST_FAIL:-0}" = 1 ]; then
      echo "herdr stub: pane list failed" >&2
      exit 1
    fi
    if [ -f "$log.split-done" ] && [ -f "${STUB_HERDR_PANE_LIST_AFTER_SPLIT:-}" ]; then
      cat "$STUB_HERDR_PANE_LIST_AFTER_SPLIT"
      exit 0
    fi
    [ -f "${STUB_HERDR_PANE_LIST:-}" ] || not_running
    cat "$STUB_HERDR_PANE_LIST"
    ;;
  "pane split "*)
    if [ "${STUB_HERDR_SPLIT_FAIL:-0}" = 1 ]; then
      not_running
    fi
    : >"$log.split-done"
    if [ "${STUB_HERDR_SPLIT_UNREADABLE:-0}" = 1 ]; then
      echo 'split: ok'
      exit 0
    fi
    echo '{"id":"cli:pane:split","result":{"pane":{"pane_id":"w1:p9","focused":false},"type":"pane_info"}}'
    ;;
  "pane run "* | "pane close "*) ;;
  "plugin pane open "*)
    [ "${STUB_HERDR_PANE_OPEN_FAIL:-0}" != 1 ] || not_running
    ;;
  "pane report-metadata "*)
    if [ "${STUB_HERDR_REPORT_FAIL:-0}" = 1 ]; then
      not_running
    fi
    ;;
  "integration status")
    [ -z "${STUB_HERDR_INTEGRATIONS:-}" ] || printf '%s\n' "$STUB_HERDR_INTEGRATIONS"
    if [ "${STUB_HERDR_INTEGRATION_FAIL:-0}" = 1 ]; then
      echo "codex: outdated (v1 < v2) (/stub/stderr-noise)" >&2
      exit 1
    fi
    ;;
  "agent list")
    if [ -f "${STUB_HERDR_AGENTS:-}" ]; then
      cat "$STUB_HERDR_AGENTS"
    else
      echo '{"id":"cli:agent:list","result":{"agents":[],"type":"agent_list"}}'
    fi
    ;;
  "pane read "*)
    [ ! -f "${STUB_HERDR_PANE_READ:-}" ] || cat "$STUB_HERDR_PANE_READ"
    ;;
  "agent prompt "*)
    if [ "${STUB_HERDR_PROMPT_FAIL:-0}" = 1 ]; then
      echo '{"error":{"code":"agent_blocked","message":"agent is blocked"},"id":"cli:agent:prompt"}'
      exit 1
    fi
    printf '%s\n' "$3" >"$log.prompt-target"
    printf '%s\n' "$#" >"$log.prompt-argc"
    printf '%s' "$4" >"$log.prompt-text"
    echo '{"id":"cli:agent:prompt","result":{"agent":{"agent_status":"working"}}}'
    ;;
  "plugin list --json")
    if [ "${STUB_HERDR_PLUGIN_LIST_FAIL:-0}" = 1 ]; then
      not_running
    fi
    plugins=''
    for plugin in ${STUB_HERDR_PLUGINS:-}; do
      plugins="${plugins:+$plugins,}{\"enabled\":true,\"plugin_id\":\"$plugin\",\"source\":{\"kind\":\"github\"}}"
    done
    printf '{"id":"cli:plugin","result":{"plugins":[%s],"type":"plugin_list"}}\n' "$plugins"
    ;;
  "plugin install "*)
    if [ "$3" = "${STUB_HERDR_INSTALL_FAIL:-}" ]; then
      echo "herdr stub: could not install $3" >&2
      exit 1
    fi
    ;;
  "plugin uninstall "*)
    if [ "$3" = "${STUB_HERDR_UNINSTALL_FAIL:-}" ]; then
      echo "plugin not installed: $3"
      exit 1
    fi
    ;;
  "plugin link "*)
    if [ "${STUB_HERDR_LINK_FAIL:-0}" = 1 ]; then
      echo '{"id":"cli:plugin","error":{"code":"invalid_manifest","message":"stub link failure"}}'
      exit 1
    fi
    echo '{"id":"cli:plugin","result":{"type":"plugin_linked"}}'
    ;;
  "plugin unlink "*)
    server_running || not_running
    if [ "$3" = "${STUB_HERDR_UNLINK_FAIL:-}" ]; then
      echo '{"id":"cli:plugin","error":{"code":"internal","message":"stub unlink failure"}}'
      exit 1
    fi
    echo '{"id":"cli:plugin","result":{"removed":true,"type":"plugin_unlinked"}}'
    ;;
  *)
    echo "herdr stub: unsupported arguments: $*" >&2
    exit 2
    ;;
esac
